  "page_size": 48,
  "deovr_section_limit": 200,
  "thumb_max_width": 480,
  "rewrite_localhost_enabled": true,
  "rewrite_to": "192.168.0.18",
  "resolve_strm_redirects": false,
  "media_url_cache_ttl": 300,
  "video_extensions": [
    ".mp4", ".mkv", ".avi", ".m4v", ".mov", ".wmv",
    ".ts", ".m2ts", ".webm", ".flv", ".mpg", ".mpeg"
  ]
}
