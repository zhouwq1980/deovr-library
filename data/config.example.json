{
  "host": "0.0.0.0",
  "port": 8765,
  "libraries": [
    {
      "name": "Movies",
      "path": "/path/to/Movies",
      "kind": "2d"
    },
    {
      "name": "Movies-VR",
      "path": "/path/to/Movies-VR",
      "kind": "vr"
    }
  ],
  "vr_screen_type": "dome",
